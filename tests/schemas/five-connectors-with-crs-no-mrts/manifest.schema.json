{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Five-connector With-CRS/No-MRTS non-promoting contract manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile", "connector", "adapter_id", "integration_mode",
    "framework_entrypoint", "framework_entrypoint_role", "host_contract_owner",
    "fixture_id", "framework_commit", "connector_commit", "validation_status",
    "host_runtime_status", "crs_repository", "crs_release_tag", "crs_commit",
    "crs_rule_file", "crs_rule_file_sha256", "run_id", "expected_rule_id",
    "observed_rule_id", "expected_status", "observed_status", "request_id",
    "transaction_id", "evidence_type", "artifacts", "no_mrts", "cleanup"
  ],
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)[A-Za-z0-9][A-Za-z0-9_./-]{0,511}$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_configuration", "allow_request", "block_audit", "cleanup", "normalized_event"
      ],
      "properties": {
        "host_configuration": {"$ref": "#/$defs/artifact"},
        "allow_request": {"$ref": "#/$defs/artifact"},
        "block_audit": {"$ref": "#/$defs/artifact"},
        "cleanup": {"$ref": "#/$defs/artifact"},
        "normalized_event": {"$ref": "#/$defs/artifact"}
      }
    },
    "no_mrts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_invoked", "case_inventory_loaded", "process_started",
        "socket_or_listener_created", "artifact_used"
      ],
      "properties": {
        "runner_invoked": {"const": false},
        "case_inventory_loaded": {"const": false},
        "process_started": {"const": false},
        "socket_or_listener_created": {"const": false},
        "artifact_used": {"const": false}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "host_processes_remaining", "helper_processes_remaining",
        "listeners_remaining", "sockets_remaining", "pid_files_remaining",
        "runtime_fixtures_remaining", "temporary_paths_remaining", "evidence_path",
        "evidence_sha256"
      ],
      "properties": {
        "status": {"const": "passed"},
        "host_processes_remaining": {"const": 0},
        "helper_processes_remaining": {"const": 0},
        "listeners_remaining": {"const": 0},
        "sockets_remaining": {"const": 0},
        "pid_files_remaining": {"const": 0},
        "runtime_fixtures_remaining": {"const": 0},
        "temporary_paths_remaining": {"const": 0},
        "evidence_path": {
          "type": "string",
          "pattern": "^(?!/)[A-Za-z0-9][A-Za-z0-9_./-]{0,511}$"
        },
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "five-connectors-with-crs-no-mrts"},
    "connector": {"enum": ["apache", "haproxy", "envoy", "traefik", "lighttpd"]},
    "adapter_id": {"$ref": "#/$defs/token"},
    "integration_mode": {"$ref": "#/$defs/token"},
    "framework_entrypoint": {
      "type": "string",
      "pattern": "^ci/runtime/run-(apache|haproxy|envoy|traefik|lighttpd)-smoke\\.sh$"
    },
    "framework_entrypoint_role": {"const": "compatibility-only"},
    "host_contract_owner": {"const": "parent"},
    "fixture_id": {"const": "crs_sqli_anomaly_block"},
    "framework_commit": {"$ref": "#/$defs/commit"},
    "connector_commit": {"$ref": "#/$defs/commit"},
    "validation_status": {"const": "CONTRACT_VALIDATED"},
    "host_runtime_status": {"const": "UNATTESTED"},
    "crs_repository": {"const": "https://github.com/coreruleset/coreruleset.git"},
    "crs_release_tag": {"const": "v4.28.0"},
    "crs_commit": {"const": "55b09f5acfd16413e7b31041100711ceb7adc89c"},
    "crs_rule_file": {"const": "rules/REQUEST-942-APPLICATION-ATTACK-SQLI.conf"},
    "crs_rule_file_sha256": {
      "const": "db756f71e8270280c5ae74d09c11250fad8c118f6a905c6a6794d5643d27cd00"
    },
    "run_id": {"$ref": "#/$defs/token"},
    "expected_rule_id": {"const": 942270},
    "observed_rule_id": {"const": 942270},
    "expected_status": {"const": 403},
    "observed_status": {"const": 403},
    "request_id": {"$ref": "#/$defs/token"},
    "transaction_id": {"$ref": "#/$defs/token"},
    "evidence_type": {"enum": ["audit", "event"]},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "no_mrts": {"$ref": "#/$defs/no_mrts"},
    "cleanup": {"$ref": "#/$defs/cleanup"}
  }
}
