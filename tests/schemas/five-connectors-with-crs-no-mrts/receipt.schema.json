{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Five-connector With-CRS/No-MRTS non-promoting contract receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile", "connector", "framework_commit", "connector_commit",
    "validation_status", "host_runtime_status", "crs_commit", "fixture_id",
    "expected_rule_id", "observed_rule_id", "run_id", "request_id", "transaction_id",
    "evidence_hashes", "no_mrts_status", "cleanup_status", "manifest_sha256"
  ],
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_configuration", "allow_request", "block_audit", "cleanup", "normalized_event"
      ],
      "properties": {
        "host_configuration": {"$ref": "#/$defs/sha256"},
        "allow_request": {"$ref": "#/$defs/sha256"},
        "block_audit": {"$ref": "#/$defs/sha256"},
        "cleanup": {"$ref": "#/$defs/sha256"},
        "normalized_event": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "five-connectors-with-crs-no-mrts"},
    "connector": {"enum": ["apache", "haproxy", "envoy", "traefik", "lighttpd"]},
    "framework_commit": {"$ref": "#/$defs/commit"},
    "connector_commit": {"$ref": "#/$defs/commit"},
    "validation_status": {"const": "CONTRACT_VALIDATED"},
    "host_runtime_status": {"const": "UNATTESTED"},
    "crs_commit": {"const": "ab3ccd5fcd691424ba3f320d4040c61417270193"},
    "fixture_id": {"const": "crs_sqli_anomaly_block"},
    "expected_rule_id": {"const": 942270},
    "observed_rule_id": {"const": 942270},
    "run_id": {"$ref": "#/$defs/token"},
    "request_id": {"$ref": "#/$defs/token"},
    "transaction_id": {"$ref": "#/$defs/token"},
    "evidence_hashes": {"$ref": "#/$defs/evidence_hashes"},
    "no_mrts_status": {"const": "passed"},
    "cleanup_status": {"const": "passed"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  }
}
