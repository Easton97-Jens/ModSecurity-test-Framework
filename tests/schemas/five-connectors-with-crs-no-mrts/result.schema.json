{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Five-connector With-CRS/No-MRTS non-promoting contract result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "connector",
    "run_id",
    "status",
    "validation_status",
    "host_runtime_status",
    "expected_rule_id",
    "observed_rule_id",
    "expected_status",
    "observed_status",
    "failure_count",
    "mismatch_count",
    "no_mrts_status",
    "cleanup_status",
    "manifest_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "five-connectors-with-crs-no-mrts"},
    "connector": {"enum": ["apache", "haproxy", "envoy", "traefik", "lighttpd"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "status": {"const": "CONTRACT_VALIDATED"},
    "validation_status": {"const": "CONTRACT_VALIDATED"},
    "host_runtime_status": {"const": "UNATTESTED"},
    "expected_rule_id": {"const": 942270},
    "observed_rule_id": {"const": 942270},
    "expected_status": {"const": 403},
    "observed_status": {"const": 403},
    "failure_count": {"const": 0},
    "mismatch_count": {"const": 0},
    "no_mrts_status": {"const": "passed"},
    "cleanup_status": {"const": "passed"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
