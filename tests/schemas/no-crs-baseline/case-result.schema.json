{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modsecurity-connector.invalid/schemas/no-crs-case-result-v1.json",
  "title": "Canonical No-CRS case result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "connector", "run_id", "integration_mode", "case_id", "group", "phase", "required_capabilities", "status", "operation_status", "live_executed", "expected_result", "observed_result", "expected_status", "actual_status", "expected_rule_id", "observed_rule_ids", "transaction_ids", "expected_event_fields", "observed_event_fields", "event_metadata_verified", "http_status", "requested_action", "actual_action", "original_http_status", "visible_http_status", "late_intervention", "headers_sent", "response_started", "body_started", "body_truncated", "response_committed", "connection_aborted", "transport_result", "late_intervention_mode", "content_type_scope", "body_limit_outcome", "marker_split_across_chunks", "end_of_stream_evaluation", "no_full_response_buffering", "first_byte_before_response_end", "upstream_response_finished_at_first_byte", "client_first_byte_received", "first_chunk_size", "upstream_paused", "upstream_eos_sent_at_first_byte", "transport_protocol", "requested_protocol", "downstream_protocol", "upstream_protocol", "negotiated_protocol", "transport", "alpn", "stream_id", "transport_case_id", "barrier_id", "connection_id", "transfer_encoding", "connection_reused", "quic_connection_id_present", "quic_version", "fallback_used", "stream_reset", "stream_reset_code", "client_aborted", "upstream_aborted", "client_disconnected", "upstream_disconnected", "cancelled", "reset_by", "reset_code", "timeout_stage", "write_result", "eos_seen", "cleanup_reason", "reason", "exit_code", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "connector": {"enum": ["apache", "nginx", "haproxy", "envoy", "traefik", "lighttpd"]},
    "run_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "integration_mode": {"type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "[A-Za-z0-9:._-]{1,64}"},
    "case_id": {"type": "string", "minLength": 1},
    "group": {"type": "string", "minLength": 1},
    "phase": {"type": "integer", "minimum": 0, "maximum": 5},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNSUPPORTED", "NOT_APPLICABLE", "NOT_EXECUTED"]},
    "operation_status": {"enum": ["ok", "error", "blocked", "unsupported"]},
    "live_executed": {"type": "boolean"},
    "required_capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "expected_result": {"type": "string", "minLength": 1},
    "observed_result": {"type": ["string", "null"]},
    "expected_status": {"type": ["integer", "null"]},
    "actual_status": {"type": ["integer", "null"]},
    "expected_rule_id": {"type": ["integer", "null"]},
    "observed_rule_ids": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
    "transaction_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_event_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "observed_event_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "event_metadata_verified": {"type": "boolean"},
    "http_status": {"type": ["integer", "null"], "minimum": 0, "maximum": 999},
    "requested_action": {"type": ["string", "null"], "enum": ["deny", "redirect", "drop", "log_only", "abort_connection", "allow", "pass", "error", null]},
    "actual_action": {"type": ["string", "null"], "enum": ["deny", "redirect", "log_only", "abort_connection", "stream_reset", "allow", "pass", "error", null]},
    "original_http_status": {"type": ["integer", "null"], "minimum": 0, "maximum": 999},
    "visible_http_status": {"type": ["integer", "null"], "minimum": 0, "maximum": 999},
    "late_intervention": {"type": ["boolean", "null"]},
    "headers_sent": {"type": ["boolean", "null"]},
    "response_started": {"type": ["boolean", "null"]},
    "body_started": {"type": ["boolean", "null"]},
    "body_truncated": {"type": ["boolean", "null"]},
    "response_committed": {"type": ["boolean", "null"]},
    "connection_aborted": {"type": ["boolean", "null"]},
    "transport_result": {"type": ["string", "null"], "enum": ["completed", "log_only", "connection_aborted", "stream_reset", "client_cancelled", "client_disconnected", "upstream_reset", "upstream_disconnected", "timeout", "short_write", "write_would_block", "engine_error", "host_error", "http_status", "not_observable", null]},
    "late_intervention_mode": {"type": ["string", "null"], "enum": ["minimal", "safe", "strict", null]},
    "content_type_scope": {"type": ["string", "null"], "enum": ["in_scope", "out_of_scope", "missing", null]},
    "body_limit_outcome": {"type": ["string", "null"], "enum": ["at_limit", "over_limit", "process_partial", "reject", null]},
    "marker_split_across_chunks": {"type": ["boolean", "null"]},
    "end_of_stream_evaluation": {"type": ["boolean", "null"]},
    "no_full_response_buffering": {"type": ["boolean", "null"]},
    "first_byte_before_response_end": {"type": ["boolean", "null"]},
    "upstream_response_finished_at_first_byte": {"type": ["boolean", "null"]},
    "client_first_byte_received": {"type": ["boolean", "null"]},
    "first_chunk_size": {"type": ["integer", "null"], "minimum": 0},
    "upstream_paused": {"type": ["boolean", "null"]},
    "upstream_eos_sent_at_first_byte": {"type": ["boolean", "null"]},
    "transport_protocol": {"type": ["string", "null"], "enum": ["http1", "http2", null]},
    "requested_protocol": {"type": ["string", "null"], "enum": ["http1", "h2", "h2c", "h3", null]},
    "downstream_protocol": {"type": ["string", "null"], "enum": ["http1", "h2", "h2c", "h3", null]},
    "upstream_protocol": {"type": ["string", "null"], "enum": ["http1", "h2", "h2c", "h3", null]},
    "negotiated_protocol": {"type": ["string", "null"], "enum": ["http1", "h2", "h2c", "h3", null]},
    "transport": {"type": ["string", "null"], "enum": ["tcp", "tls_tcp", "quic_udp", null]},
    "alpn": {"type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "[A-Za-z0-9:._/-]{1,64}"},
    "stream_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 4611686018427387903},
    "transport_case_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "[A-Za-z0-9:._-]{1,128}"},
    "barrier_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "[A-Za-z0-9:._-]{1,128}"},
    "connection_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "[A-Za-z0-9:._-]{1,128}"},
    "transfer_encoding": {"type": ["string", "null"], "enum": ["content_length", "chunked", "none", null]},
    "connection_reused": {"type": ["boolean", "null"]},
    "quic_connection_id_present": {"type": ["boolean", "null"]},
    "quic_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "[A-Za-z0-9:._-]{1,64}"},
    "fallback_used": {"type": ["boolean", "null"]},
    "stream_reset": {"type": ["boolean", "null"]},
    "stream_reset_code": {"type": ["integer", "string", "null"], "minimum": 0, "maximum": 4611686018427387903, "minLength": 1, "maxLength": 64, "pattern": "[A-Za-z0-9:._-]{1,64}"},
    "client_aborted": {"type": ["boolean", "null"]},
    "upstream_aborted": {"type": ["boolean", "null"]},
    "client_disconnected": {"type": ["boolean", "null"]},
    "upstream_disconnected": {"type": ["boolean", "null"]},
    "cancelled": {"type": ["boolean", "null"]},
    "reset_by": {"type": ["string", "null"], "enum": ["client", "upstream", "engine", "host", "strict_intervention", "timeout", null]},
    "reset_code": {"type": ["integer", "string", "null"], "minimum": 0, "maximum": 4611686018427387903, "minLength": 1, "maxLength": 64, "pattern": "[A-Za-z0-9:._-]{1,64}"},
    "timeout_stage": {"type": ["string", "null"], "enum": ["engine", "request_body", "response_body", "upstream", "client_idle", "before_commit", "after_commit", "request_headers", "response_headers", null]},
    "write_result": {"type": ["string", "null"], "enum": ["completed", "short_write", "write_would_block", "engine_error", "host_error", null]},
    "eos_seen": {"type": ["boolean", "null"]},
    "cleanup_reason": {"type": ["string", "null"], "enum": ["normal", "cancelled", "client_disconnected", "upstream_disconnected", "stream_reset", "timeout", "engine_error", "host_error", "strict_abort", "phase_sequence", "body_limit", "event_limit", "engine_timeout", "engine_unavailable", "invalid_engine_response", "connector_error", "protocol_error", "client_cancel", "upstream_disconnect", "correlation_missing", "correlation_expired", "correlation_mismatch", "cleanup_incomplete", null]},
    "reason": {"type": "string"},
    "exit_code": {"type": ["integer", "null"]},
    "artifacts": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "configtest_receipt": {"type": "object"},
    "parent_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "framework_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "mrts_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "parent_framework_gitlink": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operation": {"enum": ["native_h1_parser_rejection", "common_mapper_input_fault", "native_phase4_request", "request_sequence", "native_event_boundary_request"]},
    "driver_exit_code": {"type": ["integer", "null"]},
    "native_mapping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "native_evidence_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "fields", "origins", "event_origins", "semantic_event_origin", "semantic_event_origins", "causes", "semantics", "semantic_origins"],
      "properties": {
        "schema_version": {"const": 1},
        "fields": {"type": "object", "additionalProperties": false, "patternProperties": {
          "^[a-z][a-z0-9_]*$": {"type": "array", "minItems": 1, "maxItems": 256,
            "items": {"type": ["string", "integer", "boolean", "null"], "maxLength": 8192}}
        }},
        "origins": {"type": "object", "additionalProperties": false, "patternProperties": {
          "^[a-z][a-z0-9_]*$": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/nativeOrigin"}}
        }},
        "event_origins": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/nativeOrigin"}},
        "semantic_event_origin": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/nativeOrigin"}]},
        "semantic_event_origins": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/nativeOrigin"}},
        "causes": {"type": "array", "maxItems": 256, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["event", "phase", "transaction_id", "rule_id"],
          "properties": {
            "event": {"type": "string", "minLength": 1, "maxLength": 255},
            "phase": {"enum": ["request_headers", "request_body", "response_headers", "response_body", "logging"]},
            "transaction_id": {"type": "string", "maxLength": 128},
            "rule_id": {"type": "string", "pattern": "^[0-9]*$"},
            "http_status": {"type": "integer", "minimum": 0, "maximum": 999},
            "visible_http_status": {"type": "integer", "minimum": 0, "maximum": 999},
            "actual_action": {"type": "string", "maxLength": 255},
            "transport_result": {"type": "string", "maxLength": 255}
          }
        }},
        "semantics": {"type": "object", "additionalProperties": false,
          "required": ["phase", "phase_scope", "expected_result", "wire_status", "rule_ids"],
          "properties": {
            "phase": {"type": "integer", "minimum": 0, "maximum": 5},
            "phase_scope": {"enum": ["native_event", "host_preconnector", "lifecycle_cleanup"]},
            "expected_result": {"type": "string", "minLength": 1, "maxLength": 128},
            "wire_status": {"type": "integer", "minimum": 100, "maximum": 599},
            "rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+$"}}
          }
        },
        "semantic_origins": {"type": "object", "additionalProperties": false,
          "required": ["expected_result", "phase", "rule_ids"],
          "properties": {
            "expected_result": {"type": "object", "additionalProperties": false,
              "required": ["kind", "case_id", "operation", "source_pointer", "retained_file_sha256"],
              "properties": {
                "kind": {"const": "closed_verified_operation"},
                "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
                "operation": {"enum": ["native_h1_parser_rejection", "common_mapper_input_fault", "native_phase4_request", "request_sequence", "native_event_boundary_request"]},
                "source_pointer": {"const": "/case_id"},
                "retained_file_sha256": {"type": "object", "additionalProperties": false, "patternProperties": {
                  "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }}
              }
            },
            "phase": {"type": "object", "additionalProperties": false, "required": ["kind", "event_origins"],
              "properties": {
                "kind": {"enum": ["native_event", "host_preconnector", "lifecycle_cleanup"]},
                "event_origins": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/nativeOrigin"}}
              }
            },
            "rule_ids": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/nativeOrigin"}}
          }
        }
      }
    },
    "native_operation_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "case_id", "run_id", "operation", "integration_mode", "bundle_root", "invocations", "source_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
        "operation": {"enum": ["native_h1_parser_rejection", "common_mapper_input_fault", "native_phase4_request", "request_sequence", "native_event_boundary_request"]},
        "integration_mode": {"const": "native-nginx-http-module"},
        "bundle_root": {"type": "string", "maxLength": 4096, "pattern": "^(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)+$|^inventory/native-operations/[a-z][a-z0-9_]+$"},
        "invocations": {"type": "array", "minItems": 1, "maxItems": 2, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "receipt_path", "receipt_sha256"],
          "properties": {
            "name": {"enum": ["main", "at", "over"]},
            "receipt_path": {"type": "string", "pattern": "^(?:[a-z][a-z0-9_-]*/)?[a-z][a-z0-9_-]*\\.json$"},
            "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }},
        "source_sha256": {"type": "object", "minProperties": 1, "maxProperties": 64,
          "patternProperties": {"^(?:parent|framework):[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
          "additionalProperties": false},
        "source_record_id": {"enum": ["phase4_marker_split_across_chunks", "phase4_body_over_limit"]},
        "parent_receipt_path": {"const": "source-result.json"},
        "parent_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [{
    "if": {"required": ["native_operation_receipt"], "properties": {"status": {"const": "PASS"}}},
    "then": {"required": ["parent_sha", "framework_sha", "mrts_sha", "parent_framework_gitlink", "operation", "driver_exit_code", "native_mapping_sha256", "native_evidence_mapping"],
      "properties": {"connector": {"const": "nginx"}, "integration_mode": {"const": "native-nginx-http-module"}, "driver_exit_code": {"const": 0}}}
  }],
  "$defs": {
    "nativeOrigin": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "invocation", "artifact", "artifact_sha256", "source_pointer"],
      "properties": {
        "kind": {"enum": ["native_event", "host_observation", "operation_receipt", "downstream_wire", "response_capture_boundary", "engine_configuration"]},
        "invocation": {"enum": ["main", "at", "over"]},
        "artifact": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9_-][a-z0-9_.-]*(?:/[a-z0-9_-][a-z0-9_.-]*)*$"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_pointer": {"type": "string", "maxLength": 256, "pattern": "^/[A-Za-z0-9_/-]+$"},
        "line_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "line_index": {"type": "integer", "minimum": 0},
        "event_index": {"type": "integer", "minimum": 0},
        "transaction_id": {"type": "string", "maxLength": 128}
      }
    }
  }
}
