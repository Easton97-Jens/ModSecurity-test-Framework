{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modsecurity-connector.invalid/schemas/no-crs-configtest-receipt-v1.json",
  "title": "Bounded NGINX configuration-test receipt (not request evidence)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "connector", "operation", "run_id", "integration_mode", "parent_sha", "framework_sha", "mrts_sha", "binary_sha256", "module_sha256", "config_path_identity", "directive", "value", "expected_outcome", "expected_exit_code", "observed_exit_code", "observed_outcome", "error_class", "diagnostic_fragments", "stdout_sha256", "stderr_sha256", "process_started", "listener_created", "timestamp"],
  "allOf": [
    {"if": {"properties": {"case_id": {"const": "valid_rules_file"}}},
     "then": {"required": ["request_probe", "cleanup_verified", "listen_port", "docroot_projection_parent", "docroot_projection_root", "rules_sha256", "events_sha256", "request_sha256", "roles_sha256", "cleanup_sha256"], "properties": {"operation": {"const": "startup"}, "expected_outcome": {"const": "config_accepted"}, "expected_exit_code": {"const": 0}, "process_started": {"const": true}, "listener_created": {"const": true}}},
     "else": {"properties": {"operation": {"const": "configtest"}, "expected_outcome": {"const": "config_rejected"}, "expected_exit_code": {"const": 1}, "process_started": {"const": false}, "listener_created": {"const": false}}, "not": {"anyOf": [{"required": ["request_probe"]}, {"required": ["cleanup_verified"]}, {"required": ["listen_port"]}, {"required": ["docroot_projection_parent"]}, {"required": ["docroot_projection_root"]}, {"required": ["rules_sha256"]}, {"required": ["events_sha256"]}, {"required": ["request_sha256"]}, {"required": ["roles_sha256"]}, {"required": ["cleanup_sha256"]}]}}},
    {"if": {"properties": {"case_id": {"const": "missing_rules_file"}}},
     "then": {"required": ["fixture_leaf", "fixture_state"], "properties": {"fixture_leaf": {"const": "missing-rules.conf"}, "fixture_state": {"const": "absent"}}}},
    {"if": {"properties": {"case_id": {"const": "unsafe_event_path"}}},
     "then": {"required": ["fixture_leaf", "fixture_state"], "properties": {"fixture_leaf": {"const": "unsafe-event-directory"}, "fixture_state": {"const": "directory"}}}},
    {"if": {"properties": {"case_id": {"not": {"enum": ["missing_rules_file", "unsafe_event_path"]}}}},
     "then": {"not": {"anyOf": [{"required": ["fixture_leaf"]}, {"required": ["fixture_state"]}]}}}
  ],
  "properties": {
    "fixture_leaf": {"enum": ["missing-rules.conf", "unsafe-event-directory"]},
    "fixture_state": {"enum": ["absent", "directory"]},
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$", "maxLength": 128},
    "connector": {"const": "nginx"},
    "operation": {"enum": ["configtest", "startup"]},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$"},
    "integration_mode": {"const": "native-nginx-http-module"},
    "parent_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "framework_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "mrts_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "module_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_path_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "directive": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$", "maxLength": 128},
    "value": {"type": "string", "minLength": 1, "maxLength": 128},
    "expected_outcome": {"enum": ["config_rejected", "config_accepted"]},
    "expected_exit_code": {"enum": [0, 1]},
    "observed_exit_code": {"type": "integer", "minimum": -255, "maximum": 255},
    "observed_outcome": {"enum": ["config_rejected", "config_accepted", "unexpected_outcome"]},
    "error_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$", "maxLength": 128},
    "diagnostic_fragments": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "process_started": {"type": "boolean"},
    "listener_created": {"type": "boolean"},
    "cleanup_verified": {"const": true},
    "listen_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "docroot_projection_parent": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]+$", "maxLength": 4096},
    "docroot_projection_root": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]+$", "maxLength": 4096},
    "rules_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "events_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "roles_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cleanup_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_probe": {"type": "object", "additionalProperties": false, "required": ["observed_http_status", "client_exit_code", "phase", "rule_id", "run_id", "transaction_id"], "properties": {"observed_http_status": {"const": 403}, "client_exit_code": {"const": 0}, "phase": {"const": 1}, "rule_id": {"const": 1100001}, "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 256}, "transaction_id": {"type": "string", "pattern": "^[A-Za-z0-9:._-]{1,128}$"}}},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$", "maxLength": 32}
  }
}
