+
+// I12Observe is private test instrumentation on the actual typed transaction.
+func (transaction *commonRuntimeTransaction) I12Observe(operation, direction, eos, size, declaredSize int, result bool) {
+	if transaction == nil || transaction.engine == nil || size < 0 || declaredSize < 0 {
+		return
+	}
+	transaction.engine.mu.Lock()
+	defer transaction.engine.mu.Unlock()
+	if transaction.native == nil {
+		return
+	}
+	actualResult := 0
+	if result {
+		actualResult = 1
+	}
+	C.msc_envoy_ext_proc_transaction_i12_observe(transaction.native, C.int(operation), C.int(direction), C.int(eos), C.size_t(size), C.size_t(declaredSize), C.int(actualResult))
+}
