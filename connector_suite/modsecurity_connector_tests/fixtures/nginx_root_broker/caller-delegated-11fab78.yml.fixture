name: Protected NGINX Root Broker Lifecycle

on:
  workflow_dispatch:
    inputs:
      parent_head_sha:
        description: Declarative Parent commit identity bound only into broker evidence.
        required: true
        type: string

permissions: {}

jobs:
  framework:
    permissions:
      contents: read
    uses: Easton97-Jens/ModSecurity-test-Framework/.github/workflows/connector-protected-nginx-root-broker-caller.yml@bb6c7580208a05c17d6d6674571731b6a71028cb
    with:
      parent_head_sha: ${{ inputs.parent_head_sha }}
